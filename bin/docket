#!/bin/sh
# Launcher for the Docket module. No install step: the repo is the install.
ROOT=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
PY="${DOCKET_PYTHON:-}"
if [ -z "$PY" ]; then
    for candidate in python3 python3.14 python3.13 python3.12 python3.11; do
        if "$candidate" -I -B -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null; then
            PY="$candidate"
            break
        fi
    done
fi
if [ -z "$PY" ] || ! "$PY" -I -B -c 'import sys; sys.exit(sys.version_info < (3, 11))'; then
    echo 'Docket requires Python >=3.11; set DOCKET_PYTHON to its executable.' >&2
    exit 1
fi
exec "$PY" -m docket "$@"
